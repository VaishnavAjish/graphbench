# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The loader (bench/config.py) resolves every ${VAR} reference in
# config/databases*.yaml from the environment and REFUSES TO START if any is
# unset. A half-configured run cannot silently produce a results file that
# looks complete but covers four platforms out of five.
#
# Existing environment variables always win over this file, so CI secrets are
# never clobbered by a stale local copy.

# --- CognoDB Cloud -----------------------------------------------------------
COGNODB_URI=bolt+s://your-instance.cognodb.cloud:7687
COGNODB_USER=
COGNODB_PASSWORD=
COGNODB_DATABASE=
COGNODB_REGION=

# --- Neo4j AuraDB Free -------------------------------------------------------
# Check the current node/relationship cap in the Aura console BEFORE sizing the
# dataset. If 150k/250k exceeds it, report that as a finding.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_REGION=

# --- Memgraph Cloud ----------------------------------------------------------
MEMGRAPH_URI=bolt+s://your-instance.cloud.memgraph.com:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_REGION=

# --- FalkorDB Cloud ----------------------------------------------------------
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_REGION=

# --- ArangoDB (ArangoGraph) --------------------------------------------------
ARANGO_URL=https://your-instance.arangodb.cloud:8529
ARANGO_DATABASE=_system
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_REGION=

# --- Track B (Docker) --------------------------------------------------------
# Used by docker/docker-compose.yml and config/databases.local.yaml.
LOCAL_NEO4J_PASSWORD=benchpassword
LOCAL_ARANGO_PASSWORD=benchpassword
